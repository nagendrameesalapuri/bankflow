# ============================================================================
# BankFlow environment configuration
# Copy this file to .env at the repo root (docker-compose reads it) and/or
# into backend/.env and frontend/.env for local (non-docker) development.
# This is a fictional demo application. No real secrets belong here.
# ============================================================================

# ---- General ----
NODE_ENV=development

# ---- Backend server ----
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---- Database ----
# Used by docker-compose / a real Postgres instance.
DATABASE_URL=postgresql://bankflow:bankflow@localhost:5432/bankflow
POSTGRES_USER=bankflow
POSTGRES_PASSWORD=bankflow
POSTGRES_DB=bankflow
POSTGRES_PORT=5432

# Set to "true" to have `npm run dev` in backend/ boot a real local Postgres
# automatically via the embedded-postgres package, instead of connecting to
# the DATABASE_URL above. Useful when Docker isn't available locally.
USE_EMBEDDED_POSTGRES=false
EMBEDDED_POSTGRES_PORT=54329

# Set to "true" when DATABASE_URL points at a managed provider (Neon,
# Supabase, Render Postgres, RDS, ...) that requires SSL. Leave "false" for
# docker-compose's own postgres service or embedded-postgres.
DATABASE_SSL=false

# Docker-only convenience: migrate the schema on boot, and seed demo data
# only if the users table is empty (never wipes existing data on restart).
# docker-compose.yml sets both to "true"; local dev leaves them "false" and
# uses `npm run db:migrate` / `npm run db:seed` explicitly instead.
AUTO_MIGRATE=false
AUTO_SEED_IF_EMPTY=false

# ---- Auth / JWT ----
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_EXPIRES_IN_SECONDS=120
OTP_LENGTH=6

# ---- Rate limiting ----
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Set to "true" only when the frontend and backend are deployed on different
# domains (e.g. a Vercel frontend calling a Render backend). Leave "false"
# for same-origin deployments (Docker/nginx) and local dev.
CROSS_SITE_COOKIES=false

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000
